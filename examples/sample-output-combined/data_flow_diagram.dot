digraph nmap_flows {
  rankdir=LR;
  fontname="Helvetica"; fontsize=11;
  node [shape=box, style="rounded,filled", fillcolor="#f6f8fa", fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];
  label="Network Data-Flow Diagram (Nmap + Zeek)\nScan origin: 192.168.1.50    Scan started: Mon Jul  1 10:00:00 2026\nThis report describes services and reachability observed from the Nmap scanner’s location. It does not independently prove normal production communications between all listed systems."; labelloc="b";
  subgraph cluster_zone_0 {
    label="Zone: External (external)"; color="#cf222e"; style="rounded,dashed";
    n_203_0_113_50 [label="203.0.113.50" fillcolor="#ffebe9"];
  }
  subgraph cluster_zone_1 {
    label="Zone: Management"; color="#8c959f"; style="rounded";
    n_192_168_1_10 [label="192.168.1.10"];
    n_192_168_1_50 [label="sec-scan01\\n192.168.1.50"];
  }
  subgraph cluster_zone_2 {
    label="Zone: Servers"; color="#8c959f"; style="rounded";
    n_192_168_10_10 [label="dc01.example.local\n192.168.10.10\nMicrosoft Windows Server 2019\nDomain controller (100%)"];
    n_192_168_10_20 [label="web01.example.local\n192.168.10.20\nLinux 5.15\nWeb server (100%)"];
    n_192_168_10_30 [label="db01.example.local\n192.168.10.30\nLinux 5.15\nDatabase server (100%)"];
    n_192_168_10_40 [label="legacy01.example.local\n192.168.10.40\nMicrosoft Windows 7"];
  }
  subgraph cluster_zone_3 {
    label="Zone: Workstations"; color="#8c959f"; style="rounded";
    n_192_168_20_15 [label="192.168.20.15"];
  }
  n_192_168_1_50 -> n_192_168_10_10 [label="DNS tcp/53\nDNS udp/53\nKerberos tcp/88\nLDAP tcp/389\nSMB tcp/445", style=solid, color="#6e7781", fontcolor="#6e7781" penwidth=1.0];
  n_192_168_1_50 -> n_192_168_10_20 [label="HTTPS tcp/443 (x1) \| first 2026-07-20T08:01, last 2026-07-20T08:01, ok 1/fail 0, 1.2KB\nSSH tcp/22", style=solid, color="#6e7781", fontcolor="#6e7781" penwidth=1.3];
  n_192_168_1_50 -> n_192_168_10_30 [label="PostgreSQL tcp/5432", style=solid, color="#6e7781", fontcolor="#6e7781" penwidth=1.0];
  n_192_168_1_50 -> n_192_168_10_40 [label="Raw Print tcp/9100\nSMB tcp/445\nTelnet tcp/23", style=solid, color="#6e7781", fontcolor="#6e7781" penwidth=1.0];
  n_192_168_10_20 -> n_192_168_10_30 [label="PostgreSQL tcp/5432 (x3) \| first 2026-07-20T08:00, last 2026-07-20T08:02, ok 3/fail 0, 3.8KB", style=bold, color="#0a3069", fontcolor="#0a3069" penwidth=1.6];
  n_192_168_20_15 -> n_192_168_1_10 [label="DNS udp/53 (x2) \| first 2026-07-20T08:00, last 2026-07-20T08:00, ok 2/fail 0, 512B", style=solid, color="#1a7f37", fontcolor="#1a7f37" penwidth=1.48];
  n_192_168_20_15 -> n_203_0_113_50 [label="SSL tcp/443 (x1) \| first 2026-07-20T08:00, last 2026-07-20T08:00, ok 1/fail 0, 95.1KB, updates.example.com", style=solid, color="#1a7f37", fontcolor="#1a7f37" penwidth=1.3];
  subgraph cluster_legend {
    label="Legend"; color="#8c959f"; fontsize=10;
    node [shape=plaintext, fillcolor=white, style=""];
    leg_a_0 [label=""]; leg_b_0 [label="attempted-or-failed"];
    leg_a_0 -> leg_b_0 [style=dashed, color="#cf222e"];
    leg_a_1 [label=""]; leg_b_1 [label="corroborated-nmap-and-zeek"];
    leg_a_1 -> leg_b_1 [style=bold, color="#0a3069"];
    leg_a_2 [label=""]; leg_b_2 [label="declared-not-observed"];
    leg_a_2 -> leg_b_2 [style=dotted, color="#8250df"];
    leg_a_3 [label=""]; leg_b_3 [label="inferred"];
    leg_a_3 -> leg_b_3 [style=dashed, color="#0969da"];
    leg_a_4 [label=""]; leg_b_4 [label="manual-review"];
    leg_a_4 -> leg_b_4 [style=dashed, color="#bc4c00"];
    leg_a_5 [label=""]; leg_b_5 [label="nmap-scanner-reachability"];
    leg_a_5 -> leg_b_5 [style=solid, color="#6e7781"];
    leg_a_6 [label=""]; leg_b_6 [label="zeek-observed-traffic"];
    leg_a_6 -> leg_b_6 [style=solid, color="#1a7f37"];
  }
